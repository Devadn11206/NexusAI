# -----------------------------------------------------------------------------
# NEXUS AI Configuration Template
# -----------------------------------------------------------------------------

# Application
APP_NAME=NEXUS AI
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# PostgreSQL + pgvector Database
DATABASE_URL=postgresql+asyncpg://nexus:nexuspassword@localhost:5432/nexus_db
DB_ECHO=false

# Redis Task Queue & State Store
REDIS_URL=redis://localhost:6379/0

# Security Gatekeeper Whitelist (Comma-separated)
ALLOWED_TELEGRAM_CHAT_IDS=123456789,987654321
ALLOWED_WHATSAPP_PHONES=+1234567890,+9876543210

# Ingress Webhook Secrets & API Tokens
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
WHATSAPP_API_TOKEN=your_whatsapp_cloud_api_token_here
WHATSAPP_VERIFY_TOKEN=your_whatsapp_webhook_verify_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# AI Models (Groq Whisper-large-v3 Speech-to-Text & LLM Engines)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
WHISPER_MODEL=whisper-large-v3

# Sandbox Isolation
WORKSPACE_DIR=./workspace

